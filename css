/* ===== Design Tokens ===== */
:root {
    --color-primary: #1f4e79;
    --color-accent: #005a9c;
    --color-accent-light: #d9e1f2;
    --color-text: #222222;
    --color-bg: #f4f7f9;
    --color-surface: #ffffff;
    --color-aside: #eef3f8;
    --color-card: #fafafa;
    --color-border: #dddddd;
    --color-border-strong: #777777;
    --radius-sm: 4px;
    --radius-md: 6px;
    --bp-tablet: 48em; /* 768px, scales with user font size */
}

/* ===== Base Reset & Box Sizing ===== */
*, *::before, *::after {
    box-sizing: border-box;
}

html {
    -webkit-text-size-adjust: 100%;
            text-size-adjust: 100%;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    margin: 0;
    padding: 0;
    color: var(--color-text);
    background-color: var(--color-bg);
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column; /* Sticky footer */
}

/* ===== Fluid Media ===== */
img, video, svg {
    max-width: 100%;
    height: auto;
}

img {
    display: block;
}

/* ===== Layout ===== */
main {
    flex: 1 0 auto; /* Pushes footer to bottom */
    width: min(100% - 2rem, 1100px);
    margin: 0 auto;
    display: flex;
    flex-direction: column; /* Mobile-first single column */
    gap: 1.5rem;
    padding: 1rem 0;
}

main > section,
main > aside {
    min-width: 0;              /* Prevents flex overflow */
    overflow-wrap: anywhere;   /* Breaks long strings/URLs */
    padding: 1.5rem;
    border-radius: var(--radius-md);
}

main > section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
}

main > aside {
    background: var(--color-aside);
    border: 1px solid #cccccc;
}

/* ===== Header & Navigation ===== */
header {
    background-color: var(--color-primary);
    color: #ffffff;
    padding: 1rem;
}

header h1 {
    margin: 0 0 1rem 0;
    text-align: center;
}

.menu {
    display: flex;
    flex-direction: column; /* Stacked on mobile */
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 0.5rem;
}

.menu a {
    display: block;
    padding: 0.75rem;
    color: #ffffff;
    background-color: var(--color-accent);
    text-decoration: none;
    text-align: center;
    border-radius: var(--radius-sm);
}

.menu a:hover {
    background-color: var(--color-accent-light);
    color: var(--color-primary);
}

/* Fallback for browsers without :focus-visible */
.menu a:focus {
    background-color: var(--color-accent-light);
    color: var(--color-primary);
    outline: 2px solid #ffffff;
    outline-offset: 2px;
}

/* Keyboard-only focus ring in modern browsers */
.menu a:focus:not(:focus-visible) {
    outline: none;
}

.menu a:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
}

/* ===== Card Panel (Container Query Component) ===== */
.card-panel {
    container-type: inline-size;
    container-name: cards;
    width: 100%;
    margin-top: 1.5rem;
}

.card-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.card {
    padding: 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-card);
    min-width: 0;
}

.card h3 {
    margin-top: 0;
    color: var(--color-primary);
}

/* Container Query Breakpoint */
@container cards (min-width: 500px) {
    .card-list {
        flex-direction: row;
        flex-wrap: wrap;
    }

    .card {
        flex: 1 1 calc(50% - 0.5rem); /* Accounts for the 1rem gap exactly */
    }
}

/* ===== Tablet & Desktop ===== */
@media screen and (min-width: 48em) {
    main {
        flex-direction: row;
        align-items: flex-start; /* Remove this line to keep equal-height columns */
    }

    main > section {
        flex: 2 1 0%;
    }

    main > aside {
        flex: 1 1 0%;
    }

    .menu {
        flex-direction: row;
        justify-content: space-evenly;
    }

    .menu a {
        background-color: transparent;
    }

    .menu a:hover,
    .menu a:focus {
        background-color: var(--color-accent);
        color: #ffffff;
    }
}

/* ===== Footer ===== */
footer {
    text-align: center;
    padding: 1rem;
    background: var(--color-primary);
    color: #ffffff;
    margin-top: 2rem;
}

/* ===== Accessibility & Print ===== */
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
}

@media print {
    body {
        background: #ffffff;
        color: #000000;
    }

    .menu {
        display: none;
    }

    main {
        flex-direction: column;
    }
}
